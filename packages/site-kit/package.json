{
  "name": "@office-kit/site-kit",
  "version": "0.1.0",
  "description": "The site shell shared by the Office Kit websites: design tokens, header with the product switcher, footer, and family grid.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/office-kit/office-kit.github.io.git",
    "directory": "packages/site-kit"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./site.css": "./src/site.css"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  }
}
